<Window x:Class="Wpf10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf10"
        mc:Ignorable="d"
        Title="Малює коло" Height="400" Width="400">
    <Grid Background="#FFD4F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="82*"/>
            <ColumnDefinition Width="19*"/>
            <ColumnDefinition Width="299*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Введіть радіус кола:" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Trebuchet MS" FontWeight="Bold" FontSize="14" Grid.ColumnSpan="3"/>
        <TextBox x:Name="RadiusTextBox" Width="100" Margin="64,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="AliceBlue" Grid.Column="2"/>
        <Button Content="Нарисувати" Width="100" Margin="64,38,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="DrawCircleButton_Click" FontWeight="Bold" FontFamily="Trebuchet MS" FontSize="14" Background="Aqua" Grid.Column="2"/>
        <Canvas x:Name="DrawingCanvas" Background="Azure" Margin="10,100,10,10" Grid.ColumnSpan="3"/>
    </Grid>
</Window>
